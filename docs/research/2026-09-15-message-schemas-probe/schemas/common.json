{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ratedtattoo.ru/schemas/common.json",
  "title": "Общие листовые типы (проба, имена вне ADR — предварительные)",
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-5][0-9](\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})$",
      "description": "Профиль RFC 3339 §5.6 (замечание владельца 2026-09-15, P1): дата и время через T/t, секунды 00–59 (добавочная секунда :60 отклоняется — предложение), необязательная дробная часть, смещение Z/z или ±HH:MM с двоеточием; +HHMM и +HH отклоняются. format проверяет календарную корректность, pattern — профиль, одинаково на обеих сторонах"
    },
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Профиль UUID (P1): каноническая форма RFC 9562 §4 в нижнем регистре без префикса urn:uuid:"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "media_type": {
      "type": "string",
      "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
    },
    "file_descriptor": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "media_type": {
          "$ref": "#/$defs/media_type"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "key",
        "size",
        "media_type",
        "sha256"
      ]
    },
    "studio_rules": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "text",
        "version"
      ]
    },
    "size_spec": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": "string",
          "enum": [
            "mm",
            "cm"
          ]
        }
      },
      "required": [
        "value",
        "unit"
      ]
    },
    "model_settings": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "model"
      ]
    },
    "style": {
      "type": "string",
      "minLength": 1
    },
    "placement": {
      "type": "string",
      "minLength": 1
    }
  }
}
